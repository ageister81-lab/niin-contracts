{
  "name": "@niinid/contracts",
  "version": "0.1.0",
  "description": "Niin API and event contracts: OpenAPI specs, CloudEvent schemas, generated TS types and Zod validators. Change contracts here first.",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ageister81-lab/niin-contracts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi/*": "./openapi/*",
    "./events/*": "./events/*"
  },
  "files": [
    "dist",
    "openapi",
    "events"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "gen:openapi": "pnpm build && node scripts/gen-openapi.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
